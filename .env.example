# Copy this file to .env (or export the variables) and fill in your values.

# Proxmox host or IP (the node you connect through; it can see the whole cluster)
PROXMOX_HOST=192.168.1.10
PROXMOX_PORT=8006

# API token, created under: Datacenter > Permissions > API Tokens
# Token id has the form user@realm!tokenname
PROXMOX_TOKEN_ID=root@pam!pmox
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000

# Homelab Proxmox uses self-signed certs by default, so keep this false.
# Set to true only if your node has a valid (CA-signed) certificate.
PROXMOX_VERIFY_SSL=false

PROXMOX_TIMEOUT=30

# Optional: always emit JSON (handy when an AI is driving the CLI)
# PMOX_JSON=1
