# Copy this file to .env (or export the variables) and fill in your values.

# Proxmox host or IP (the node you connect through; it can see the whole cluster)
PROXMOX_HOST=192.168.1.10
PROXMOX_PORT=8006

# API token, created under: Datacenter > Permissions > API Tokens
# Token id has the form user@realm!tokenname
PROXMOX_TOKEN_ID=root@pam!pmox
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000

# Homelab Proxmox uses self-signed certs by default, so keep this false.
# Set to true only if your node has a valid (CA-signed) certificate.
PROXMOX_VERIFY_SSL=false

PROXMOX_TIMEOUT=30

# Output auto-detects: JSON when piped/captured (e.g. an AI driving the CLI),
# tables at an interactive terminal. Force it globally if you like:
#   1 = always JSON, 0 = always tables, auto = detect (the default).
# PMOX_JSON=auto

# PMOX_DANGEROUS=1 enables write mode globally — but ONLY from the real
# environment: pmox deliberately ignores it when set in a .env file, so a stray
# project file can't silently enable writes. Use --dangerous per command instead.

# vm up builds/clones agent golden templates by default (guest-agent IPs).
# Set to 0 to always provision raw images instead.
# PMOX_AGENT_TEMPLATES=1
